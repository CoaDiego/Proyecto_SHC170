# =========================================================================
# CONFIGURACIÓN DEL BACKEND (Python FastAPI)
# =========================================================================

# URL de conexión a la Base de Datos
# Reemplazar con las credenciales correspondientes. Ejemplo: mysql+pymysql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=mysql+pymysql://usuario_bd:tu_password_aqui@localhost:3306/estadistica_db

# Seguridad y Autenticación JWT (Generar una clave secreta segura en producción)
SECRET_KEY=tu_secret_key_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configuración de Correo Electrónico (Notificaciones SMTP)
EMAIL_SENDER=tu_correo_emisor@gmail.com
EMAIL_PASSWORD=tu_password_de_aplicacion_aqui
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587


# =========================================================================
# CONFIGURACIÓN DEL FRONTEND (React Vite)
# =========================================================================

# URL de la API del Backend (utilizada por Axios/Fetch en el cliente)
# En desarrollo suele ser http://localhost:8000. En producción, la URL del servidor backend.
VITE_API_URL=http://localhost:8000
